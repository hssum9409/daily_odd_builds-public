{
  "manifest_version": 3,
  "name": "디시 스크롤 도우미",
  "version": "1.5.0",
  "description": "긴 디시 글에서도 버튼과 키보드로 댓글·글 목록·맨 아래까지 부드럽게 이동하세요. 단축키와 버튼 색상·크기·위치·여러 줄 배치를 설정할 수 있습니다.",
  "icons": {
    "16": "icons/brand16.png",
    "32": "icons/brand32.png",
    "48": "icons/brand48.png",
    "128": "icons/brand128.png"
  },
  "permissions": ["storage"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [{
    "matches": [
      "https://gall.dcinside.com/board/view*",
      "https://gall.dcinside.com/board/lists*",
      "https://gall.dcinside.com/mgallery/board/view*",
      "https://gall.dcinside.com/mgallery/board/lists*",
      "https://gall.dcinside.com/mini/board/view*",
      "https://gall.dcinside.com/mini/board/lists*",
      "https://gall.dcinside.com/",
      "https://gall.dcinside.com/?*",
      "https://gall.dcinside.com/index.php*",
      "https://gall.dcinside.com/m*",
      "https://gall.dcinside.com/n*",
      "https://gallog.dcinside.com/*"
    ],
    "js": ["page-context.js", "shortcuts.js", "settings.js", "navigation.js", "ui.js", "content_script.js"],
    "run_at": "document_idle"
  }],
  "web_accessible_resources": [{
    "resources": ["style.css", "icons/toolbar-atlas.png", "icons/directory-g.png", "icons/directory-m.png", "icons/custom-atlas.png"],
    "matches": ["https://gall.dcinside.com/*", "https://gallog.dcinside.com/*"]
  }]
}
