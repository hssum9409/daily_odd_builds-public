#!/bin/bash
set -euo pipefail
umask 077
root="$HOME/Library/Application Support/Token Scale"
[ "$(cat "$root/product-id")" = 'DailyOddBuilds.TokenScale' ] || exit 1
if [ "${1:-}" != '--start' ]; then printf 'connect' > "$root/connect.request"; fi
if ! /bin/launchctl kickstart "gui/$(id -u)/org.dailyoddbuilds.token-scale" 2>/dev/null; then
  # Never exec the daemon in the LaunchServices parent. Disconnect stdin and both outputs.
  home="$(cat "$root/data-home.txt")"
  mkdir -p "$home"
  /usr/bin/nohup /bin/bash "$root/host.sh" </dev/null >/dev/null 2>&1 &
fi
